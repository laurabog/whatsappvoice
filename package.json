{
  "name": "whatsapp-voice-summary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc",
    "config:check": "tsx src/config-check.ts",
    "db:check": "tsx src/db/check.ts",
    "db:migrate": "tsx src/db/migrations.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run test/db/repositories.integration.test.ts",
    "test:openai": "vitest run test/integration/openai-processing.integration.test.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "openai": "^7.3.0",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.20.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
