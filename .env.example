NODE_ENV=development
PORT=3000
DATABASE_URL=
TEST_DATABASE_URL=

# Choose this value yourself, then paste the same token into the Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard > WhatsApp > API setup. Use a system-user token in production.
WHATSAPP_ACCESS_TOKEN=
# Meta App Dashboard > App settings > Basic. Used for x-hub-signature-256 checks.
WHATSAPP_APP_SECRET=
# Meta App Dashboard > WhatsApp > API setup. This is the Phone Number ID, not the WABA ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_MS=60000

MAX_AUDIO_BYTES=16777216
MAX_AUDIO_DURATION_SECONDS=600
MAX_DAILY_MESSAGES_PER_USER=10
MAX_TRANSCRIPT_REPLY_CHARS=3500

SUMMARY_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=30
JOB_METADATA_RETENTION_DAYS=90
PENDING_LABEL_TTL_MINUTES=30
WORKER_POLL_INTERVAL_MS=5000
PROCESSING_JOB_TIMEOUT_MS=900000
RETENTION_CLEANUP_INTERVAL_MS=3600000

AUDIO_DURATION_PROBE=disabled
TEMP_AUDIO_DIR=/tmp/whatsapp-summary-audio
SENTRY_DSN=
